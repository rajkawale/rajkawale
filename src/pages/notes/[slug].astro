---
import BaseLayout from '../../components/BaseLayout.astro';
import BackNavigation from '../../components/ui/BackNavigation.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  try {
    const linkedinPosts = await getCollection('linkedin', (entry) => !entry.data.draft);

    if (!linkedinPosts || linkedinPosts.length === 0) {
      return [];
    }

    return linkedinPosts.map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
  } catch (error) {
    console.error('Error in getStaticPaths for notes:', error);
    return [];
  }
}

const { post } = Astro.props;
const { Content } = await render(post);

const postDate = typeof post.data.date === 'string'
  ? new Date(post.data.date)
  : post.data.date;

const siteUrl = (Astro.site?.href || "https://www.rajkawale.com").replace(/\/$/, "");
const noteSchema = {
  "@context": "https://schema.org",
  "@type": "SocialMediaPosting",
  headline: post.data.title,
  datePublished: postDate.toISOString(),
  url: `${siteUrl}/notes/${post.id}`,
  author: { "@id": `${siteUrl}/#person` },
};
---

<BaseLayout
  title={`${post.data.title} | Raj Kawale`}
  description={`A note from Raj Kawale on ${post.data.title.toLowerCase()}, originally shared on LinkedIn.`}
  keywords="product management insights, mental models, AI products, systems thinking, decision making"
>
  <script type="application/ld+json" set:html={JSON.stringify(noteSchema)} />
  <main class="min-h-screen bg-[#020617] text-zinc-300 pt-24 py-24 px-6 md:px-12 relative z-10">
    <article class="max-w-4xl mx-auto">
      <header class="mb-12 border-b border-zinc-800 pb-6">
        <div class="mb-4 flex items-center justify-between">
          <time
            datetime={postDate.toISOString()}
            class="text-sm font-mono text-zinc-500"
          >
            {postDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {post.data.canonicalUrl && (
            <a
              href={post.data.canonicalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="moonlight-container border border-white/20 bg-zinc-900/50 px-3 py-1 text-xs font-mono text-zinc-300 transition-all duration-300 ease-out hover:bg-zinc-800 rounded"
            >
              View on LinkedIn
            </a>
          )}
        </div>
        <h1 class="mb-4 text-4xl md:text-5xl font-serif font-bold text-slate-100">
          {post.data.title}
        </h1>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="border border-zinc-800/50 bg-zinc-950/50 px-3 py-1 text-xs font-mono text-zinc-400 rounded">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>
      
      <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-slate-100 prose-p:text-zinc-300 prose-a:text-[#888] prose-a:no-underline prose-a:hover:underline">
        <Content />
      </div>
      
      <footer class="mt-12 border-t border-zinc-800 pt-6">
        <BackNavigation href="/notes" label="Back to notes" />
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  .prose a {
    color: #888;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease-out;
  }
  .prose a:hover {
    color: #fff;
    text-decoration: underline;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
  }
</style>

