---
import BaseLayout from "../components/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import BackNavigation from "../components/ui/BackNavigation.astro";

const formspreeEndpoint = "https://formspree.io/f/mldykebp";
---

<BaseLayout
  title="Contact | Raj Kawale"
  description="Get in touch with Raj Kawale to discuss AI and SaaS product roles, consulting opportunities, or collaborations on scaling technology products."
  keywords="AI product manager contact, SaaS product consultant, product collaboration"
>
  <main
    class="min-h-screen bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-slate-800 via-slate-900 to-black text-zinc-300 pb-32 md:pb-16 px-6 md:px-12 relative z-10 flex items-center"
    style="padding-top: 150px;"
  >
    <div class="max-w-2xl mx-auto w-full">
      <header class="mb-10 border-b border-zinc-800 pb-6">
        <h1
          class="text-4xl md:text-5xl font-serif font-bold text-slate-100 mb-4"
        >
          Let's Connect
        </h1>
        <p class="text-lg text-zinc-300 font-sans">
          Interested in collaborating, discussing a project, or just want to
          connect? Fill out the form below and I'll get back to you.
        </p>
      </header>

      <div class="mb-8 bg-white/[0.03] backdrop-blur-xl border border-white/10 rounded-lg p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="text-lg font-serif text-slate-100 mb-1">Prefer a 1:1 conversation?</h2>
          <p class="text-sm text-zinc-400 font-sans">Book a session directly on Topmate.</p>
        </div>
        <a
          href="https://topmate.io/rajkawale"
          target="_blank"
          rel="noopener noreferrer"
          class="moonlight-container inline-flex items-center justify-center gap-2 px-6 py-3 border border-white/20 text-white font-medium rounded-lg transition-all duration-300 ease-out hover:bg-white/10 font-sans whitespace-nowrap"
          data-track="Click_Topmate"
        >
          Book on Topmate →
        </a>
      </div>

      <ContactForm formspreeEndpoint={formspreeEndpoint} />

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-zinc-500 font-sans">
        <span>Or reach out directly:</span>
        <a href="mailto:rajendrakawale101@gmail.com" class="text-zinc-300 hover:text-white transition-colors">rajendrakawale101@gmail.com</a>
        <a href="https://www.linkedin.com/in/rajkawale/" target="_blank" rel="noopener noreferrer" class="text-zinc-300 hover:text-white transition-colors">LinkedIn</a>
      </div>
    </div>
  </main>

  <script>
    document.querySelectorAll('[data-track="Click_Topmate"]').forEach((link) => {
      link.addEventListener('click', () => {
        const win = window as any;
        if (typeof window !== 'undefined' && win.clarity) {
          win.clarity('event', 'Click_Topmate');
        }
      });
    });
  </script>
</BaseLayout>
