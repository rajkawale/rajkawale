---
import BaseLayout from "../components/BaseLayout.astro";
import SmartBackButton from "../components/ui/SmartBackButton.astro";

const siteUrl = (Astro.site?.href || "https://www.rajkawale.com").replace(/\/$/, "");
const personId = `${siteUrl}/#person`;

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${siteUrl}/about/#profilepage`,
  url: `${siteUrl}/about`,
  mainEntity: { "@id": personId },
};

const faq = [
  {
    q: "What does Raj Kawale do?",
    a: "Product Lead at Indegene, building GenAI and Agentic AI products for healthcare. He helps healthcare organizations adopt AI in ways that fit real workflows, regulatory constraints, and business goals. He runs product like a founder: he owns the problem, the build, and the outcome.",
  },
  {
    q: "What is KOS?",
    a: "An exocortex Raj is building outside work hours. Before it answers, it has to commit to a position and a probability, then it gets scored against what actually happened. It is where he tests how far AI reasoning and the human brain can go together.",
  },
  {
    q: "What is RaiTalk?",
    a: "Talk to your AI psychologist. RaiTalk was a GenAI conversational platform Raj took from idea to production in 2 weeks. 20% of users returned without paid acquisition. He sunset it when what he had learned outgrew the product.",
  },
  {
    q: "What is Madhav Farm?",
    a: "A farm-to-consumer marketplace Raj built from scratch. ₹8L in GMV with zero working capital and an 8-person team.",
  },
  {
    q: "Who should talk to Raj Kawale?",
    a: "Founders, tech and product leaders, and investors thinking about where AI goes next. Compare notes via rajkawale.com/contact, topmate.io/rajkawale, LinkedIn (linkedin.com/in/rajkawale), or GitHub (github.com/rajkawale).",
  },
  {
    q: "Where is Raj Kawale based?",
    a: "Bengaluru, India.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title="About | Raj Kawale — Product Lead, GenAI & Agentic AI"
  description="Product Lead at Indegene building GenAI and Agentic AI for healthcare. Runs product like a founder. Building KOS outside work hours. Previously founded RaiTalk and Madhav Farm."
  keywords="Raj Kawale, Product Lead, GenAI, Agentic AI, healthcare AI, Indegene, KOS, RaiTalk, AI psychologist, Madhav Farm"
>
  <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="min-h-screen bg-[#020617] text-zinc-300 pt-24 relative z-10 pb-[120px] md:pb-16">
    <article class="max-w-2xl mx-auto px-5 md:px-12 py-16">
      <header class="mb-10">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-slate-100 mb-6">
          About
        </h1>
        <p class="text-xl text-zinc-200 leading-relaxed font-sans">
          Product Lead at Indegene, building GenAI and Agentic AI products for healthcare. I help healthcare organizations adopt AI in ways that fit real workflows, regulatory constraints, and business goals.
        </p>
      </header>

      <div class="space-y-10 font-sans text-lg text-zinc-300 leading-relaxed">
        <section>
          <h2 class="text-2xl font-serif text-slate-100 mb-4">What I actually do</h2>
          <p class="mb-4">
            I run product like a founder: I own the problem, the build, and the outcome, in a domain where "mostly right" isn't good enough. I take it from the first question to what actually ships.
          </p>
          <p class="mb-4">
            That ownership comes from having been the founder. Across 6+ years in enterprise SaaS, AI, healthcare, and e-commerce, I've also built two products from scratch.
          </p>
          <p class="mb-4">
            <a href="/work/raitalk" class="text-white underline hover:no-underline">RaiTalk</a> — talk to your AI psychologist. A GenAI conversational platform. Idea to production in 2 weeks, 20% returning users without paid acquisition. When what I'd learned outgrew the product, I sunset it.
          </p>
          <p>
            <a href="/work/madhav-farm" class="text-white underline hover:no-underline">Madhav Farm</a> — a farm-to-consumer marketplace. ₹8L in GMV with zero working capital and an 8-person team.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-serif text-slate-100 mb-4">Outside work hours</h2>
          <p>
            I'm building <a href="/work/kos" class="text-white underline hover:no-underline">KOS</a>, an exocortex: an AI that has to commit to a position and a probability before it answers, then gets scored against what actually happened. It's where I test how far AI reasoning and the human brain can go together.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-serif text-slate-100 mb-4">What building has taught me</h2>
          <div class="space-y-5">
            <p>
              <span class="text-white">Question before you build.</span> The problem in the brief is rarely the real one. I keep asking why until I reach the root, because the most expensive thing a team can ship is a great answer to the wrong question.
            </p>
            <p>
              <span class="text-white">Learn from the root, not the trend.</span> Models, tools, and frameworks turn over every quarter. What lasts is knowing why something works: the user's behaviour, the business model, the tech and resource constraints.
            </p>
            <p>
              <span class="text-white">Ship to learn.</span> A shipped version teaches you what a perfect plan never will. It's how RaiTalk got to production in 2 weeks, and when what I'd learned outgrew the product, I sunset it.
            </p>
            <p>
              <span class="text-white">Commit, then get scored.</span> Take a position, put a number on it, let reality grade you. It's the fastest way I know to get better.
            </p>
            <p>
              <span class="text-white">Constraints beat resources.</span> Madhav Farm did ₹8L in GMV on zero working capital. When you can't spend your way out, you're forced to find the one bottleneck and fix that.
            </p>
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-serif text-slate-100 mb-4">Before this</h2>
          <p class="mb-4">
            I've walked into someone else's mess more than once. A 15-year-old PHP monolith at <a href="/work/nextech-ar" class="text-white underline hover:no-underline">Nextech AR</a>. A checkout at <a href="/work/pernias-popup" class="text-white underline hover:no-underline">Pernia's Pop-Up Shop</a> that was losing customers mid-purchase. A marketing team at <a href="/work/sinch" class="text-white underline hover:no-underline">Sinch</a> that didn't trust its own data.
          </p>
          <p>
            <a href="/work" class="text-white underline hover:no-underline">The full list is here →</a>
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-serif text-slate-100 mb-4">Questions people actually ask</h2>
          <div class="space-y-5">
            {faq.map((item) => (
              <p>
                <span class="text-white font-medium">{item.q}</span><br />
                <span class="text-zinc-400">{item.a}</span>
              </p>
            ))}
          </div>
        </section>

        <section class="pt-2 border-t border-white/10">
          <h2 class="text-2xl font-serif text-slate-100 mb-4 mt-8">Talk to me</h2>
          <p>
            If you're a founder, tech or product leader, or investor thinking about where AI goes next, I'd like to compare notes.{" "}
            <a href="mailto:rajendrakawale101@gmail.com" class="text-white underline hover:no-underline">Email</a>,{" "}
            <a href="https://topmate.io/rajkawale" target="_blank" rel="noopener noreferrer" class="text-white underline hover:no-underline">book time</a>,{" "}
            or find me on{" "}
            <a href="https://www.linkedin.com/in/rajkawale/" target="_blank" rel="noopener noreferrer" class="text-white underline hover:no-underline">LinkedIn</a>
            {" "}and{" "}
            <a href="https://github.com/rajkawale" target="_blank" rel="noopener noreferrer" class="text-white underline hover:no-underline">GitHub</a>.
          </p>
        </section>
      </div>

      <div class="mt-16 border-t border-white/10 pt-8">
        <SmartBackButton fallbackHref="/" />
      </div>
    </article>
  </main>
</BaseLayout>
