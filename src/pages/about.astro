---
import BaseLayout from "../components/BaseLayout.astro";
import SmartBackButton from "../components/ui/SmartBackButton.astro";

const siteUrl = (Astro.site?.href || "https://www.rajkawale.com").replace(/\/$/, "");
const personId = `${siteUrl}/#person`;

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${siteUrl}/about/#profilepage`,
  url: `${siteUrl}/about`,
  mainEntity: { "@id": personId },
};

const faq = [
  {
    q: "What does Raj Kawale do?",
    a: "Leads GenAI and Agentic AI product development at Indegene, building for healthcare organizations from the first framing conversation through to a client actually using what he built.",
  },
  {
    q: "What is KOS?",
    a: "Raj's own exocortex project, built nights and weekends: an AI that has to commit to a position and a probability before it answers, then gets scored against what actually happened — not against how helpful the answer felt. One user right now: its founder.",
  },
  {
    q: "Where does Raj Kawale currently work?",
    a: "Product Lead for GenAI & Agentic AI at Indegene, based in Bengaluru, India.",
  },
  {
    q: "How can I book time with Raj Kawale?",
    a: "Directly, at topmate.io/rajkawale — or through the contact form if you'd rather write first.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title="About | Raj Kawale — Product Lead, GenAI & Agentic AI"
  description="Raj Kawale is a Product Lead building GenAI and Agentic AI systems at Indegene, and the founder behind KOS (an exocortex) and RaiTalk. Background, current work, and how to connect."
  keywords="Raj Kawale, Product Lead GenAI, Agentic AI, Indegene, KOS exocortex, RaiTalk, about Raj Kawale"
>
  <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="min-h-screen bg-[#020617] text-zinc-300 pt-24 relative z-10 pb-[120px] md:pb-16">
    <article class="max-w-2xl mx-auto px-5 md:px-12 py-16">
      <header class="mb-10">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-slate-100 mb-6">
          About
        </h1>
        <p class="text-xl text-zinc-200 leading-relaxed font-sans">
          Product Lead. Two-time founder. Six years turning ambiguous problems into shipped products — the last year finding out how much of that I can still do without anyone assigning it to me.
        </p>
      </header>

      <div class="space-y-10 font-sans text-lg text-zinc-300 leading-relaxed">
        <section>
          <h2 class="text-2xl font-serif text-slate-100 mb-4">What I actually do</h2>
          <p class="mb-4">
            At Indegene, I lead GenAI and Agentic AI product work for healthcare — LLM orchestration meeting clinical workflows, where "mostly right" isn't good enough. That's the day job, and it's a real one.
          </p>
          <p class="mb-4">
            At night, I build <a href="/work/kos" class="text-white underline hover:no-underline">KOS</a>. Nobody asked for it. It's an AI that has to commit to a position and a probability before it answers, then gets scored against what actually happened — not against how helpful the answer felt. One user right now: me.
          </p>
          <p class="mb-4">
            Before KOS, there was <a href="/work/raitalk" class="text-white underline hover:no-underline">RaiTalk</a> — an AI built to help people see their own thinking patterns instead of handing them advice. It ran for ten months, real users, real conversations. Then I sunset it, because the thing I actually learned from it — that judgment matters more than model size — is what KOS exists to test properly.
          </p>
          <p>
            Same question keeps showing up in both: where does human thinking and machine reasoning actually meet, instead of one quietly replacing the other.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-serif text-slate-100 mb-4">Before this</h2>
          <p class="mb-4">
            I've walked into someone else's mess more than once. A 15-year-old PHP monolith at <a href="/work/nextech-ar" class="text-white underline hover:no-underline">Nextech AR</a>. A checkout at <a href="/work/pernias-popup" class="text-white underline hover:no-underline">Pernia's Pop-Up Shop</a> that was losing customers mid-purchase. A marketing team at <a href="/work/sinch" class="text-white underline hover:no-underline">Sinch</a> that didn't trust its own data.
          </p>
          <p>
            And <a href="/work/madhav-farm" class="text-white underline hover:no-underline">Madhav Farm</a> — my own business, a farmer-to-buyer marketplace I ran by hand before I let any of it be automated. <a href="/work" class="text-white underline hover:no-underline">The full list is here →</a>
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-serif text-slate-100 mb-4">How I think</h2>
          <p>
            First principles before solutions. Systems over features — find the loop, not the symptom. I'd rather ship the boring infrastructure fix nobody wants to fund than the feature that looks good in a roadmap review and breaks in production.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-serif text-slate-100 mb-4">Questions people actually ask</h2>
          <div class="space-y-5">
            {faq.map((item) => (
              <p>
                <span class="text-white font-medium">{item.q}</span><br />
                <span class="text-zinc-400">{item.a}</span>
              </p>
            ))}
          </div>
        </section>

        <section class="pt-2 border-t border-white/10">
          <h2 class="text-2xl font-serif text-slate-100 mb-4 mt-8">Talk to me</h2>
          <p>
            Building something, stuck on something, or want to argue about whether AI is the next rung or the last one —
            <a href="https://topmate.io/rajkawale" target="_blank" rel="noopener noreferrer" class="text-white underline hover:no-underline">book time</a>,
            <a href="/contact" class="text-white underline hover:no-underline">write in</a>, or find me on
            <a href="https://www.linkedin.com/in/rajkawale/" target="_blank" rel="noopener noreferrer" class="text-white underline hover:no-underline">LinkedIn</a>
            and <a href="https://github.com/rajkawale" target="_blank" rel="noopener noreferrer" class="text-white underline hover:no-underline">GitHub</a>.
          </p>
        </section>
      </div>

      <div class="mt-16 border-t border-white/10 pt-8">
        <SmartBackButton fallbackHref="/" />
      </div>
    </article>
  </main>
</BaseLayout>
